server {
    listen [::]:443 ssl;
    listen 443 ssl;
    server_name dash.electronlibre.info;
    include snippets/dash-security-deny.conf;

    include snippets/dash-api-jwt.conf;

    root /var/www/dash.electronlibre.info;
    index index.php index.html;

    client_max_body_size 128M;

    ssl_certificate /etc/letsencrypt/live/dash.electronlibre.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dash.electronlibre.info/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = / {
        return 302 /client/;
    }

    location = /client {
        return 301 /client/;
    }

    location = /dash_admin {
        return 301 /admin/;
    }
    location ^~ /dash_admin/ {
        rewrite ^/dash_admin/?(.*)$ /admin/$1 permanent;
    }
    location = /dash_electron {
        return 301 /client/;
    }
    location ^~ /dash_electron/ {
        rewrite ^/dash_electron/?(.*)$ /client/$1 permanent;
    }

    location = /login {
        return 302 /client/login.php?$args;
    }

    include snippets/dash-admin-auth.conf;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|webp|pdf)$ {
        expires 7d;
        access_log off;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ ^/admin/(cache|logs)/ {
        deny all;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name dash.electronlibre.info;
    include snippets/dash-security-deny.conf;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
