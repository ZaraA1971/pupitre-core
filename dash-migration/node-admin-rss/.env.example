# Local admin inbox only. Never put production credentials here.
# Defaults: fixtures + all externals disabled.

DASH_DB_MODE=fixtures
# DASH_DB_MODE=mysql
# DASH_DB_HOST=127.0.0.1
# DASH_DB_PORT=3306
# DASH_DB_USER=dash_local
# DASH_DB_PASSWORD=
# DASH_DB_NAME=dash_disposable
# DASH_DB_ALLOW_SCHEMA_INIT=1
# DASH_DB_ALLOW_REMOTE=0

DASH_DISABLE_EXTERNAL=1
# Narrow: allow HTTP(S) RSS fetch only (Vigie/Desk/Firebase stay off).
# DASH_ALLOW_FEED_HTTP=1
# Shadow worker (real feeds → disposable MySQL only):
# DASH_SHADOW_FEED_LIMIT=3
# DASH_SHADOW_CATALOG=./fixtures/shadow-catalog.json
# DASH_SHADOW_PROD_SAMPLE=./fixtures/shadow-prod-sample.json
DASH_ADMIN_BIND=127.0.0.1
DASH_ADMIN_PORT=8791

DASH_MAIL_FROM=dash@electronlibre.info
DASH_SERVER_NAME=localhost

# Intentionally empty — real Desk / Firebase / OpenAI stay off this bench
DASH_DESK_INGEST_URL=
DASH_DESK_INGEST_KEY=
DASH_FIREBASE_PUSH_AUTH=
DASH_OPENAI_API_KEY=
DASH_OPENAI_MODEL=
